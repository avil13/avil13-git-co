    "inquirer-autocomplete-prompt": "^2.0.1"
  },
  "devDependencies": {
    "@types/inquirer": "^8.2.13",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
