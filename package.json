{
  "name": "avil13-co",
  "version": "2.5.6",
  "description": "",
  "main": "dist/index.js",
  "public": true,
  "bin": {
    "co": "./bin/co"
  },
  "files": [
    "dist",
    "bin",
    "src",
    "assets"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "start": "npm run build && node dist/index.js",
    "dev": "npm run build && node dist/index.js",
